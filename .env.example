# Comma-separated keys that clients must send as "Authorization: Bearer <key>"
GATEWAY_API_KEYS=dev-key-1,dev-key-2

# Upstream provider credentials (leave empty to use the built-in mock provider)
GEMINI_API_KEY=

# Providers to try, in order. Falls through to the next one on failure.
PROVIDER_ORDER=gemini,mock

# Token bucket per API key
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Response cache
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

DB_PATH=gateway.db
