# ---- Auth -----------------------------------------------------------------
# Comma-separated keys clients must send as "Authorization: Bearer <key>"
GATEWAY_API_KEYS=dev-key-1,dev-key-2

# ---- Providers (tried in PROVIDER_ORDER; ones without a key are skipped) ----
GEMINI_API_KEY=
# GEMINI_MODEL=            # optional: force this model regardless of what clients request
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
PROVIDER_ORDER=gemini,groq,openrouter,mock
PROVIDER_TIMEOUT=30

# ---- Resilience -------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.2
RETRY_MAX_DELAY=2.0
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=30

# ---- Rate limiting (token bucket per API key) ---------------------------------
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# ---- Cache ----------------------------------------------------------------------
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
# Serve paraphrases from cache. Use SEMANTIC_EMBEDDER=gemini for real paraphrases;
# the default "hashing" embedder only catches near-identical rewordings.
SEMANTIC_CACHE=false
SEMANTIC_EMBEDDER=hashing
SEMANTIC_THRESHOLD=0.92

# ---- Storage (leave empty/default for zero-setup local dev) ---------------------
# REDIS_URL=redis://localhost:6379/0                 # shared cache + rate limiter
DATABASE_URL=sqlite:///gateway.db                    # or postgresql://user:pass@host:5432/db

# ---- Benchmark helpers (simulated upstream) --------------------------------------
# MOCK_LATENCY_MS=200
# FLAKY_FAIL_RATE=0.3
